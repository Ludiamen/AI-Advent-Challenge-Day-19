# Секреты — никогда не коммитим реальные ключи
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Результаты работы агента и временные файлы
out/
*.tmp

# Хранилища памяти. Файлы создаются сами.
*.db
*.db-journal

# Память агента: там профиль и переписка, в репозиторий это не нужно.
# Косая черта в начале обязательна: без неё правило «memory/» задевает и
# пакет кода agent/memory/, и свежий репозиторий остаётся без модулей памяти.
/memory/
/cli-check-memory/

# Каталог прогона демонстрации.
/demo-memory/

# Отчёты, которые конвейер сохраняет сам (День 19). Это результат работы агента,
# как и память: в репозиторий он не нужен, каталог создаётся при первом прогоне.
/reports/

# Рабочие данные мок-трекера. Исходные лежат в tracker-seed.json и коммитятся,
# а это — то, что сервис успел изменить: комментарии, статусы.
/tracker-data.json
